# === 1. APPLICATION BINARIES & EXECUTABLES ===
# Block compiled Go binaries generated by your local environment builds
*.exe
*.exe~
*.dll
*.so
*.dylib
forum-exec
web/main

# === 2. EMBEDDED DATABASES & WORKING STATES ===
# Crucial: Blocks the local physical SQLite database file from being committed!
# Each environment must construct its own database locally via schema migrations.
*.db
*.sqlite
*.sqlite3
forum.db
*.db-shm
*.db-wal
test_forum.db

# === 3. CONTAINERS & ENVIRONMENT ARTIFACTS ===
# Exclude local build environments, state logs, or local storage layers
.env
.env.local
.env.*.local
docker-compose.override.yml

# === 4. TESTING TOOLS & PROFILE RESULTS ===
# Block Go compilation test profiles and cover diagnostics results data structures
*.test
*.out
c.out
cpu.pprof
mem.pprof

# === 5. SYSTEM DEBRIS ===
# Avoid shipping operating system specific configuration folder elements
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
